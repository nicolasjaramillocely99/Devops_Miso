{
  "info": {
    "name": "Blacklist API - Entrega 4",
    "description": "Pruebas funcionales para la API desplegada en AWS Fargate detras del Application Load Balancer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_email')) {",
          "    var suffix = Date.now();",
          "    pm.collectionVariables.set('run_email', 'postman-' + suffix + '@example.com');",
          "    pm.collectionVariables.set('missing_email', 'missing-' + suffix + '@example.com');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Preparar variables de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var suffix = Date.now();",
              "pm.collectionVariables.set('run_email', 'postman-' + suffix + '@example.com');",
              "pm.collectionVariables.set('missing_email', 'missing-' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Variables de prueba generadas', function () {",
              "    pm.expect(pm.collectionVariables.get('run_email')).to.include('@example.com');",
              "    pm.expect(pm.collectionVariables.get('missing_email')).to.include('@example.com');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Inicializa emails unicos para la corrida de Postman y valida conectividad basica con el ALB."
      }
    },
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta tiene status healthy y version', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('healthy');",
              "    pm.expect(jsonData.version).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifica que el microservicio esta activo. No requiere autenticacion."
      },
      "response": [
        {
          "name": "Health Check - 200 OK",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"status\": \"healthy\",\n    \"version\": \"1.0.4\"\n}"
        }
      ]
    },
    {
      "name": "02 - Crear email en blacklist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Respuesta confirma creacion', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('Email agregado a la lista negra exitosamente');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{run_email}}\",\n    \"app_uuid\": \"{{app_uuid}}\",\n    \"blocked_reason\": \"Prueba automatizada desde Postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "Caso positivo: crea un email en la blacklist usando Bearer token."
      },
      "response": [
        {
          "name": "Creado - 201",
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"message\": \"Email agregado a la lista negra exitosamente\"\n}"
        }
      ]
    },
    {
      "name": "03 - Consultar email creado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Email esta en blacklist', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.is_blacklisted).to.eql(true);",
              "    pm.expect(jsonData.blocked_reason).to.eql('Prueba automatizada desde Postman');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{run_email}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "{{run_email}}"
          ]
        },
        "description": "Caso positivo: consulta el email creado durante la corrida."
      },
      "response": [
        {
          "name": "Encontrado - 200",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"is_blacklisted\": true,\n    \"blocked_reason\": \"Prueba automatizada desde Postman\"\n}"
        }
      ]
    },
    {
      "name": "04 - Consultar email no existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Email no esta en blacklist', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.is_blacklisted).to.eql(false);",
              "    pm.expect(jsonData.blocked_reason).to.eql('');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{missing_email}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "{{missing_email}}"
          ]
        },
        "description": "Caso negativo funcional: email valido que no existe debe responder 200 con is_blacklisted=false."
      },
      "response": [
        {
          "name": "No encontrado - 200",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"is_blacklisted\": false,\n    \"blocked_reason\": \"\"\n}"
        }
      ]
    },
